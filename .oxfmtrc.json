{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  // package.json keeps its keys in the order they were written.
  "sortPackageJson": false,
  "overrides": [
    {
      // Attribute selectors keep double quotes, as the tests reading the stylesheets match them.
      "files": ["*.css"],
      "options": { "singleQuote": false }
    }
  ],
  "ignorePatterns": [
    // The formatter would pad every Markdown table to its widest cell.
    "*.md",
    // Written by `npm run types` through Prettier; the two agree on it now, but the generator's output is the file.
    "src/types.ts",
    // Cut from a real export and written by `npm run fixture`.
    "tests/fixtures/",
    "tests/build/fixtures/",
    "syntax/",
    "package-lock.json",
    // Generated by a build or by `npm run data`.
    "public/",
    "dist/",
    "dist-*/"
  ]
}
